{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FileConfig",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "Ignored: a `\"$schema\": \"https://.../server.config.json\"` key so\neditors with JSON Schema support (e.g. VS Code) offer completion\nand inline docs while editing this file. See\n`schema/server.config.json` and `docs/server.md#published-schema`.",
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "listen": {
      "type": [
        "string",
        "null"
      ]
    },
    "data_dir": {
      "type": [
        "string",
        "null"
      ]
    },
    "repos": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "default": {}
    },
    "tokens": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FileToken"
      }
    },
    "credentials": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FileCredential"
      }
    },
    "tenants": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/FileTenantPolicy"
      }
    },
    "tls": {
      "anyOf": [
        {
          "$ref": "#/$defs/FileTls"
        },
        {
          "type": "null"
        }
      ]
    },
    "max_body_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint",
      "minimum": 0
    },
    "max_artifact_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "max_running": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint",
      "minimum": 0
    },
    "shutdown_grace_seconds": {
      "type": [
        "number",
        "null"
      ],
      "format": "double"
    },
    "harness_commands": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "default": {}
    },
    "allow_client_commands": {
      "type": "boolean",
      "default": false
    },
    "allow_providers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "allow_delegation": {
      "type": "boolean",
      "default": false
    },
    "by_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "allow_unapproved_tools": {
      "type": "boolean",
      "default": false
    },
    "allow_workspace_scripts": {
      "description": "Run served repositories' `[workspace]` scripts (branchyard.toml)\nfor new branches: `true` for every repository, or a list of\nrepository names. Off by default; see docs/workspace.md.",
      "anyOf": [
        {
          "$ref": "#/$defs/FileWorkspaceScripts"
        },
        {
          "type": "null"
        }
      ]
    },
    "secrets": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "default": {}
    },
    "database": {
      "type": [
        "string",
        "null"
      ]
    },
    "labels": {
      "description": "The labels this server's worker carries; it claims only operations\nwhose `require_labels` are all among them. See\ndocs/server.md#worker-labels.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "unclaimable_after_seconds": {
      "description": "How long an operation may wait queued before it says why no live\nworker can claim it. Default 60.",
      "type": [
        "number",
        "null"
      ],
      "format": "double"
    },
    "webhooks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FileWebhook"
      }
    },
    "webhook_insecure": {
      "type": "boolean",
      "default": false
    },
    "connectors": {
      "description": "The connector gateway (docs/connectors.md): where it is, which\nbundles it serves, and whether this server runs it.",
      "anyOf": [
        {
          "$ref": "#/$defs/FileConnectors"
        },
        {
          "type": "null"
        }
      ]
    },
    "public_url": {
      "description": "This server's URL as webhook senders reach it (behind a proxy, its\npublic address): the base of each event trigger's webhook URL.\nDefault: http(s)://<listen>. See docs/triggers.md.",
      "type": [
        "string",
        "null"
      ]
    },
    "allow_trigger_prechecks": {
      "description": "Let triggers of served repositories run a precheck command before\nfiring: `true` for every repository, or a list of repository names.\nOff by default; see docs/triggers.md.",
      "anyOf": [
        {
          "$ref": "#/$defs/FileWorkspaceScripts"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "FileToken": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "token": {
          "type": [
            "string",
            "null"
          ]
        },
        "token_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "tenant": {
          "description": "This principal's tenant; defaults to [`DEFAULT_TENANT`] when this\nentry gives no tenant, scopes or repos of its own.",
          "type": [
            "string",
            "null"
          ]
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "repos": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "FileCredential": {
      "type": "object",
      "properties": {
        "token_sha256": {
          "type": "string"
        },
        "tenant": {
          "type": "string"
        },
        "name": {
          "description": "Defaults to `token_sha256`'s first 12 characters when omitted.",
          "type": [
            "string",
            "null"
          ]
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "repos": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "token_sha256",
        "tenant"
      ]
    },
    "FileTenantPolicy": {
      "type": "object",
      "properties": {
        "repos": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "default": null
        },
        "max_running": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "max_branches": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "max_cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "max_artifact_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "FileTls": {
      "type": "object",
      "properties": {
        "cert": {
          "type": "string"
        },
        "key": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "cert",
        "key"
      ]
    },
    "FileWorkspaceScripts": {
      "description": "`allow_workspace_scripts` as written: `true`, `false`, or repository\nnames.",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "FileWebhook": {
      "type": "object",
      "properties": {
        "id": {
          "description": "Defaults to the URL when omitted.",
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": "string"
        },
        "secret": {
          "type": [
            "string",
            "null"
          ]
        },
        "secret_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "events": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false,
      "required": [
        "url"
      ]
    },
    "FileConnectors": {
      "description": "`connectors`: the connector gateway; see `docs/connectors.md`.",
      "type": "object",
      "properties": {
        "gateway": {
          "description": "The gateway's canonical `/mcp` URL, such as\n`http://127.0.0.1:8931/mcp`: every token's audience.",
          "type": "string"
        },
        "sandbox_gateway": {
          "description": "The gateway as a sandboxed harness reaches it.",
          "type": [
            "string",
            "null"
          ]
        },
        "issuer": {
          "description": "Every token's issuer. Default: this server's URL.",
          "type": [
            "string",
            "null"
          ]
        },
        "signing_key": {
          "description": "The signing key, a private JSON Web Key Set made if missing.\nDefault: `<data_dir>/gateway/key`. Its public keys are served at\n`GET /.well-known/jwks.json`.",
          "type": [
            "string",
            "null"
          ]
        },
        "audit_file": {
          "description": "The gateway's audit log. Default: `<data_dir>/gateway/audit.jsonl`.",
          "type": [
            "string",
            "null"
          ]
        },
        "bundles": {
          "description": "The bundle root the gateway serves.",
          "type": "string"
        },
        "anvil": {
          "description": "Anvil's command and leading arguments. Default `[\"anvil\"]`.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "run_gateway": {
          "description": "Run the gateway beside the server, supervised. Default false.",
          "type": "boolean",
          "default": false
        },
        "listen": {
          "description": "The address the gateway listens on when run here, when not\nloopback.",
          "type": [
            "string",
            "null"
          ]
        },
        "vault_key": {
          "description": "The gateway's vault key (a 0600 file of 64 hex characters).\nDefault: `<data_dir>/gateway/vault.key`, made if missing.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "gateway",
        "bundles"
      ]
    }
  }
}
