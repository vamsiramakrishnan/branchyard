{
  "credentials": [
    {
      "keys": [
        [
          "mcpServers",
          "docs"
        ]
      ],
      "kind": "json",
      "path": ".gemini/config/mcp_config.json"
    }
  ],
  "mcp_servers": [
    "docs"
  ],
  "permissions": {
    "allow": [
      "command(regex:by .*)",
      "command(regex:/usr/local/bin/by .*)"
    ],
    "deny": [
      "write_file(*)"
    ],
    "path": ".gemini/antigravity-cli/settings.json"
  }
}
