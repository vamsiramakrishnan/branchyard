{
  "mcpServers": {
    "branchyard": {
      "headers": {
        "Authorization": "Bearer turn-token"
      },
      "serverUrl": "http://192.168.127.1:41000/mcp"
    },
    "docs": {
      "args": [
        "--stdio"
      ],
      "command": "/usr/bin/docs-mcp",
      "env": {
        "LEVEL": "1"
      },
      "type": "stdio"
    },
    "search": {
      "args": [
        "--stdio"
      ],
      "command": "/usr/bin/search-mcp",
      "env": {
        "LEVEL": "1"
      },
      "type": "stdio"
    },
    "users-own": {
      "command": "/opt/mine"
    }
  }
}
