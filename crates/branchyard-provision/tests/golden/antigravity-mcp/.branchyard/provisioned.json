{
  "credentials": [
    {
      "keys": [
        [
          "mcpServers",
          "docs"
        ],
        [
          "mcpServers",
          "search"
        ],
        [
          "mcpServers",
          "branchyard"
        ]
      ],
      "kind": "json",
      "path": ".gemini/config/mcp_config.json"
    }
  ],
  "mcp_servers": [
    "docs",
    "search",
    "branchyard"
  ],
  "permissions": {
    "allow": [
      "command(*)",
      "mcp(docs/*)",
      "mcp(search/*)",
      "mcp(branchyard/*)"
    ],
    "path": ".gemini/antigravity-cli/settings.json"
  }
}
