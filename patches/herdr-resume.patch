+#[cfg(test)]
+mod boundary_tests {
+    use super::*;
+
+    #[test]
+    fn rejects_flag_shaped_ids_and_bypassed_constructors() {
+        for value in ["--last", "", "line\nfeed"] {
+            let session = AgentSessionRef {
+                kind: AgentSessionRefKind::Id,
+                value: value.into(),
+            };
+            assert!(plan("herdr:codex", "codex", &session).is_none());
+        }
+        let session = AgentSessionRef {
+            kind: AgentSessionRefKind::Path,
+            value: "relative.jsonl".into(),
+        };
+        assert!(plan("herdr:pi", "pi", &session).is_none());
+    }
