# Release actor/worker image. Inputs are pinned in deploy/agy-release.json.
FROM rust:1.94.0-bookworm AS build
RUN apt-get update && apt-get install -y --no-install-recommends libcap-ng-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /source
COPY . .
ENV CARGO_INCREMENTAL=0 CARGO_PROFILE_RELEASE_STRIP=symbols
RUN cargo fetch --locked \
    && cargo build --release --locked --offline --features branchyard-cli/microsandbox,branchyard-cli/postgres,branchyard-server/postgres \
       -p branchyard-cli -p branchyard-server -p branchyard-bridge

FROM ubuntu:24.04
LABEL org.opencontainers.image.source="https://github.com/vamsiramakrishnan/branchyard"
RUN apt-get update \
    && apt-get install -y --no-install-recommends git python3 procps ca-certificates coreutils libcap-ng0 libstdc++6 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /source/target/release/by /source/target/release/branchyard-server /usr/local/bin/
COPY --from=build /source/target/release/branchyard-bridge /usr/local/libexec/branchyard-bridge
COPY --chmod=755 deploy/substrate-entrypoint.sh /usr/local/bin/branchyard-bridge
COPY --chmod=755 agy /usr/local/bin/agy
ENV BRANCHYARD_ACTOR_UID=1000 BRANCHYARD_ACTOR_GID=1000 \
    BRANCHYARD_ACTOR_WORKDIR=/workspace BRANCHYARD_ACTOR_HOME=/branchyard/home HOME=/branchyard/home
RUN install -d -o 1000 -g 1000 -m 0700 /workspace /branchyard/home
USER 1000:1000
RUN by --version && branchyard-server --version && /usr/local/libexec/branchyard-bridge --version && agy --version
USER 0:0
WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/branchyard-bridge"]
