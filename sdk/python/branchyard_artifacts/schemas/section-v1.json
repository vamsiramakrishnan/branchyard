{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Branchyard section v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "section"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
    },
    "design_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "elements": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "box": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 4,
                      "maxItems": 4
                    },
                    "font_size_pt": {
                      "type": "number",
                      "minimum": 6,
                      "maximum": 96
                    },
                    "kind": {
                      "const": "text"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "space_after_pt": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 36
                    }
                  },
                  "required": [
                    "kind",
                    "box",
                    "text"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "box": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 4,
                      "maxItems": 4
                    },
                    "font_size_pt": {
                      "type": "number",
                      "minimum": 6,
                      "maximum": 96
                    },
                    "kind": {
                      "const": "table"
                    },
                    "headers": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "rows": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "array",
                        "items": {
                          "type": [
                            "string",
                            "number",
                            "boolean",
                            "null"
                          ]
                        }
                      }
                    }
                  },
                  "required": [
                    "kind",
                    "box",
                    "headers",
                    "rows"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "image"
                    },
                    "box": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 4,
                      "maxItems": 4
                    },
                    "asset_id": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
                    }
                  },
                  "required": [
                    "kind",
                    "box",
                    "asset_id"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "chart"
                    },
                    "box": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 4,
                      "maxItems": 4
                    },
                    "chart_type": {
                      "enum": [
                        "column",
                        "bar",
                        "line",
                        "pie"
                      ]
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1
                    },
                    "unit": {
                      "type": "string",
                      "minLength": 1
                    },
                    "number_format": {
                      "type": "string",
                      "minLength": 1
                    },
                    "categories": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "series": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string",
                            "minLength": 1
                          },
                          "values": {
                            "type": "array",
                            "minItems": 1,
                            "items": {
                              "type": "number"
                            }
                          }
                        },
                        "required": [
                          "name",
                          "values"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "kind",
                    "box",
                    "chart_type",
                    "title",
                    "unit",
                    "number_format",
                    "categories",
                    "series"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": "string",
                  "pattern": "^https?://[^\\s]+$"
                },
                "source": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "locator": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    }
                  },
                  "required": [
                    "path",
                    "sha256",
                    "locator"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "label"
              ],
              "oneOf": [
                {
                  "required": [
                    "url"
                  ]
                },
                {
                  "required": [
                    "source"
                  ]
                }
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "title",
          "elements",
          "citations"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "design_id",
    "assets",
    "slides"
  ],
  "additionalProperties": false
}
