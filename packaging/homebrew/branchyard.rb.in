# Homebrew formula template for a Branchyard release. Fill each @...@ from
# the release's SHA256SUMS (docs/distribution.md#homebrew), then publish it
# in a tap of your own; nothing here is published by Branchyard's CI.
class Branchyard < Formula
  desc "Delegate coding work to agent harnesses on git branches; merge only validated results"
  homepage "https://github.com/vamsiramakrishnan/branchyard"
  version "@VERSION@"
  license "Apache-2.0"

  base = "https://github.com/vamsiramakrishnan/branchyard/releases/download/v@VERSION@"

  on_macos do
    on_arm do
      url "#{base}/branchyard-@VERSION@-aarch64-apple-darwin.tar.gz"
      sha256 "@SHA256_AARCH64_APPLE_DARWIN@"
    end
    on_intel do
      url "#{base}/branchyard-@VERSION@-x86_64-apple-darwin.tar.gz"
      sha256 "@SHA256_X86_64_APPLE_DARWIN@"
    end
  end

  on_linux do
    on_arm do
      url "#{base}/branchyard-@VERSION@-aarch64-unknown-linux-musl.tar.gz"
      sha256 "@SHA256_AARCH64_UNKNOWN_LINUX_MUSL@"
    end
    on_intel do
      url "#{base}/branchyard-@VERSION@-x86_64-unknown-linux-musl.tar.gz"
      sha256 "@SHA256_X86_64_UNKNOWN_LINUX_MUSL@"
    end
  end

  depends_on "git"

  def install
    bin.install "by", "branchyard-server"
    doc.install "README.md", "THIRD_PARTY.md"
    (share/"branchyard").install "LICENSE", "licenses"
    generate_completions_from_executable(bin/"by", "completions")
    (man1/"by.1").write Utils.safe_popen_read(bin/"by", "man")
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/by --version")
    system "git", "init", "-q", testpath/"repo"
    cd testpath/"repo" do
      assert_match "no recipes", shell_output("#{bin}/by recipe list")
    end
  end
end
