# Generated from dist's archives and checksums by tools/homebrew_formula.py.
class Branchyard < Formula
  desc "Delegate coding work to agent harnesses on git branches"
  homepage "https://github.com/vamsiramakrishnan/branchyard"
  version "@VERSION@"
  license "Apache-2.0"

  base = "https://github.com/vamsiramakrishnan/branchyard/releases/download/v@VERSION@"
  target = if OS.mac?
    Hardware::CPU.arm? ? "aarch64-apple-darwin" : "x86_64-apple-darwin"
  else
    Hardware::CPU.arm? ? "aarch64-unknown-linux-musl" : "x86_64-unknown-linux-musl"
  end
  checksums = {
@CHECKSUMS@
  }
  url "#{base}/branchyard-cli-#{target}.tar.gz"
  sha256 checksums.fetch(target).fetch("branchyard-cli")
  ["branchyard-server", "branchyard-bridge"].each do |binary|
    resource binary do
      url "#{base}/#{binary}-#{target}.tar.gz"
      sha256 checksums.fetch(target).fetch(binary)
    end
  end

  depends_on "git"

  def install
    bin.install "by"
    resources.each { |binary| binary.stage { bin.install binary.name } }
    doc.install "README.md" if File.exist?("README.md")
    doc.install "THIRD_PARTY.md"
    (share/"branchyard").install "LICENSE", "licenses"
    generate_completions_from_executable(bin/"by", "completions")
    (man1/"by.1").write Utils.safe_popen_read(bin/"by", "man")
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/by --version")
    system "git", "init", "-q", testpath/"repo"
    cd testpath/"repo" do
      assert_match "no recipes", shell_output("#{bin}/by recipe list")
    end
  end
end
