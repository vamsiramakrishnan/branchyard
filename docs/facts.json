  "cli": {
    "exit_codes": [
      {
        "code": 0,
        "name": "Success",
        "meaning": "the command did what it was asked",
        "kinds": []
      },
      {
        "code": 1,
        "name": "Failed",
        "meaning": "the operation ran and failed: a branch failed, a check failed, a merge conflicted, the branch was busy; also a failure not yet given a kind (`unclassified`), and any kind not listed here",
        "kinds": [
          "already_merged",
          "check_failed",
          "check_not_started",
          "check_timed_out",
          "command_failed",
          "conflict",
          "dirty_target",
          "fenced",
          "git",
          "harness",
          "incomplete",
          "internal",
          "invalid_answers",
          "invalid_candidate",
          "invalid_plan",
          "io",
          "no_candidate",
          "no_plan",
          "not_running",
          "running",
          "stale_revision",
          "state",
          "steer_refused",
          "target_moved",
          "unclassified",
          "would_overwrite"
        ]
      },
      {
        "code": 2,
        "name": "Usage",
        "meaning": "the command line asks for what cannot be: a bad flag or value (clap's own usage errors too), an unknown branch, harness or repository, a name already taken",
        "kinds": [
          "branch_exists",
          "invalid_memory",
          "invalid_name",
          "invalid_request",
          "invalid_rig",
          "not_found",
          "unknown_branch",
          "unknown_harness",
          "unknown_knowledge",
          "unknown_memory",
          "unknown_message",
          "unknown_operation",
          "unknown_repo",
          "unknown_skill",
          "unknown_trigger",
          "usage"
        ]
      },
      {
        "code": 3,
        "name": "Environment",
        "meaning": "something around the command must change first: not a repository, a harness (or gh, ssh) not installed, a configuration file that does not load, a server that does not answer or refuses the token, a login only you can do",
        "kinds": [
          "config",
          "harness_unavailable",
          "manual",
          "not_a_repository",
          "remote_protocol",
          "remote_unreachable",
          "shutting_down",
          "tool_unavailable",
          "unauthorized"
        ]
      },
      {
        "code": 4,
        "name": "Refused",
        "meaning": "refused before anything ran: a policy, a delegation envelope, a budget or quota, or a capability the harness lacks",
        "kinds": [
          "command_not_allowed",
          "delegation_not_allowed",
          "denied",
          "provider_not_allowed",
          "quota_exceeded",
          "rate_limited",
          "repo_not_allowed",
          "scope_required",
          "secret_not_allowed",
          "unapproved_tools_not_allowed",
          "unsupported"
        ]
      },
      {
        "code": 130,
        "name": "Interrupted",
        "meaning": "interrupted with Ctrl-C: the shell reports 128 + SIGINT. `by serve` and `by worker` catch it and shut down; `by substrate check --smoke` catches SIGINT and SIGTERM to remove its actor, then reports the cancelled smoke with exit 1",
        "kinds": []
      }
    ]
  },
  "stages": [
    {
      "reason": "approval",
      "lane": "needs_you",
      "condition": "Its running turn is parked on an approval ask. It moves only when you allow or deny it."
    },
    {
      "reason": "question",
      "lane": "needs_you",
      "condition": "It sent a question or escalation that nobody has answered, and it is running or it asked you."
    },
    {
      "reason": "stalled",
      "lane": "needs_you",
      "condition": "It is running, and its harness has been silent for its stall window."
    },
    {
      "reason": "parent",
      "lane": "running",
      "condition": "It is a delegated child that settled without being merged or discarded, and its parent still runs or waits. Its parent decides what comes next."
    },
    {
      "reason": "awaiting_plan_approval",
      "lane": "needs_you",
      "condition": "Its plan waits for you to approve, edit or reject it."
    },
    {
      "reason": "failed",
      "lane": "needs_you",
      "condition": "Its turn failed."
    },
    {
      "reason": "interrupted",
      "lane": "needs_you",
      "condition": "Its turn was cancelled, or the engine running it stopped."
    },
    {
      "reason": "budget_exceeded",
      "lane": "needs_you",
      "condition": "A limit you set stopped it."
    },
    {
      "reason": "blocked",
      "lane": "needs_you",
      "condition": "A prerequisite did not succeed, so it will not start until its graph changes."
    },
    {
      "reason": "running",
      "lane": "running",
      "condition": "A turn is in progress."
    },
    {
      "reason": "waiting_on_children",
      "lane": "running",
      "condition": "Its turn ended while its children still ran. It starts again on its own when they settle."
    },
    {
      "reason": "waiting",
      "lane": "running",
      "condition": "It waits for its prerequisites to settle."
    },
    {
      "reason": "ready",
      "lane": "ready",
      "condition": "Its candidate waits to be merged."
    },
    {
      "reason": "no_changes",
      "lane": "done",
      "condition": "Its last turn changed no file."
    },
    {
      "reason": "merged",
      "lane": "done",
      "condition": "Its candidate was integrated."
    },
    {
      "reason": "discarded",
      "lane": "done",
      "condition": "It was set aside on purpose."
    }
  ],
