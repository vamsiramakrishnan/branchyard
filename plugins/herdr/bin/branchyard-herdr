#!/bin/sh
# Finds the branchyard-herdr binary: $BRANCHYARD_HERDR_BIN, else the one
# the manifest's build step leaves in this repository's target/release,
# else the one on PATH. `by` is found the same way (BRANCHYARD_BY).
here=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$here/../../.." && pwd)
if [ -z "$BRANCHYARD_BY" ] && [ -x "$root/target/release/by" ]; then
    BRANCHYARD_BY="$root/target/release/by"
    export BRANCHYARD_BY
fi
if [ -n "$BRANCHYARD_HERDR_BIN" ]; then
    exec "$BRANCHYARD_HERDR_BIN" "$@"
fi
if [ -x "$root/target/release/branchyard-herdr" ]; then
    exec "$root/target/release/branchyard-herdr" "$@"
fi
exec branchyard-herdr "$@"
